{
    "name": "drewlabs/laravel-http-guard",
    "description": "Laravel/Lumen authentication guard using using HTTP protocol interface",
    "type": "library",
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "license": "MIT",
    "keywords": [
        "laravel",
        "guard",
        "http"
    ],
    "autoload": {
        "psr-4": {
            "Drewlabs\\HttpGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drewlabs\\HttpGuard\\Tests\\": "src/"
        }
    },
    "authors": [
        {
            "name": "azandrew-sidoine",
            "email": "asmyns.platonnas29@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "drewlabs/contracts": "^0.4",
        "drewlabs/core-helpers": "^0.4",
        "drewlabs/curl-rest-client": "^0.3.0|^0.4.0",
        "illuminate/auth": "^11.0|^12.0|^13.0"
    },
    "suggest": {
        "predis/predis": "Required to use the redis cache provider.",
        "ext/memcached": "Required to use the memcached provider.",
        "drewlabs/net": "Required to ping available servers ^0.1.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Drewlabs\\HttpGuard\\ServiceProvider"
            ]
        }
    }
}